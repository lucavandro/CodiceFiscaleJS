{
  "name": "codice-fiscale-js",
  "version": "2.4.0",
  "description": "The Italian Tax Code Library for Javascript and Typescript",
  "main": "dist/codice.fiscale.commonjs2.js",
  "types": "types/codice-fiscale.d.ts",
  "repository": {
    "type": "git",
    "url": "git://github.com/lucavandro/CodiceFiscaleJS.git"
  },
  "directories": {
    "test": "tests"
  },
  "devDependencies": {
    "@babel/cli": "^7.10.5",
    "@babel/core": "^7.10.5",
    "@babel/preset-env": "^7.10.4",
    "babel-jest": "^30.4.1",
    "babel-loader": "^8.1.0",
    "jest": "^29.7.0",
    "standard": "^17.1.2",
    "webpack": "^5.109.2",
    "webpack-cli": "^7.2.2"
  },
  "standard": {
    "env": [
      "jest"
    ],
    "ignore": [
      "update_comuni.js",
      "comuni-optimizer-loader.js",
      "example/",
      "dist/"
    ]
  },
  "scripts": {
    "build": "npm run webpack && npm run rename",
